package colorgame;

import static colorgame.Color.*;
import static colorgame.Match.*;
import java.util.Map;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
import org.junit.jupiter.api.Test;
import java.util.List;

public class MasterMindTest {
    @Test //Feedback: please use 2-space indentations
    void canary() {
        assertTrue(true);
    }

    @Test
    void guessWithAllColorsMatchInPosition() {
        var selectedColors = List.of(RED, GREEN, BLUE, WHITE, ORANGE, PURPLE);
        var userDefinedColors = List.of(RED, GREEN, BLUE, WHITE, ORANGE, PURPLE); //Feedback: var userDefinedColors = selectedColors;

        var response = MasterMind.guess(selectedColors, userDefinedColors); //Feedback: we can do a static import above and use guess instead of MasterMind.guess

        assertEquals(Map.of(EXACT, 6), response);
    }

    @Test
    void guessWithAllColorsDoNotMatchInPosition(){
        var selectedColors = List.of(MOCHA, WHITE, VIOLET, YELLOW, BLUE, PURPLE);
        var userDefinedColors = List.of(PURPLE, YELLOW, RED, GREEN, CYAN, WHITE);
        
        var response = MasterMind.guess(selectedColors, userDefinedColors);

        assertEquals(Map.of(NOMATCH, 0), response);
        
    }

    //Feedback: please make sure, instead of the following, to implement the tests mentioned in tests.txt
    //Feedback: starting here, let us use the full Map, like Map.of(EXACT, ..., PARTIAL, ..., NOMATCH, ...)

    @Test
    void guessWithFirstFourColorsMatchPosition(){
        var selectedColors = List.of(RED, GREEN, BLUE, WHITE, YELLOW, CYAN);
        var userDefinedColors = List.of(RED, GREEN, BLUE, WHITE, ORANGE, PURPLE);

        var response = MasterMind.guess(selectedColors, userDefinedColors);
        assertEquals(Map.of(PARTIAL, 4), response);
    }

    @Test
    void guessWithLastFourColorsMatchPosition(){
        var selectedColors = List.of(MOCHA, CYAN, BLUE, WHITE, ORANGE, PURPLE);
        var userDefinedColors = List.of(RED, GREEN, BLUE, WHITE, ORANGE, PURPLE);

        var response = MasterMind.guess(selectedColors, userDefinedColors);
        assertEquals(Map.of(PARTIAL, 4), response); 
    }

    @Test
    void guessWithFirstThreeColorsInPosition(){
        var selectedColors = List.of(RED, GREEN, BLUE, YELLOW, PURPLE, ORANGE);
        var userDefinedColors = List.of(RED, GREEN, BLUE, WHITE, ORANGE, PURPLE);

        var response = MasterMind.guess(selectedColors, userDefinedColors);
        assertEquals(Map.of(PARTIAL, 3), response);
    }

    @Test
    void guessWithOnlySecondInPosition(){
        var selectedColors = List.of(RED, GREEN, BLUE, YELLOW, PURPLE, ORANGE);
        var userDefinedColors = List.of(CYAN, GREEN, YELLOW, WHITE, ORANGE, PURPLE);

        var response = MasterMind.guess(selectedColors, userDefinedColors);
        assertEquals(Map.of(PARTIAL, 1), response);
    }

    @Test
    void generateValidColorCombination(){ //Feedback: please remove
        var combo = MasterMind.generateCombination();

        assertTrue(combo.size() == 6);
    }
}
