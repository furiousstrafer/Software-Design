package colorgame;

import java.util.List;
import java.util.Map;
import static colorgame.Match.*;

import java.util.ArrayList;
import java.util.Iterator;

public interface MasterMind {
  static List<Integer> colorMatching(List<Color> actualCombination, List<Color> userCombination){
    Iterator<Color> selected = actualCombination.iterator();
    Iterator<Color> user = userCombination.iterator();
    List<Integer> match = new ArrayList<Integer>();

    while(selected.hasNext()){
      if(selected.next() == user.next())
        match.add(1);
      else
        match.add(0);
    }
    
    return match;
  }

  static Map<Match, Integer> guess(List<Color> actualCombination, List<Color> userCombination) {
    if (actualCombination.equals(userCombination)) {
      return Map.of(EXACT, 6);
    }

    var check = colorMatching(actualCombination, userCombination);

    return matchPattern(check);
  }

  private static Map<Match, Integer> matchPattern(List<Integer> check) {
    var allPatternsMap = Map.ofEntries(
      Map.entry(List.of(1, 1, 1, 1, 1, 1), 6),
      Map.entry(List.of(1, 1, 1, 1, 1, 0), 5),
      Map.entry(List.of(1, 1, 1, 1, 0, 0), 4),
      Map.entry(List.of(1, 1, 1, 0, 0, 0), 3),
      Map.entry(List.of(1, 1, 0, 0, 0, 0), 2),
      Map.entry(List.of(1, 0, 0, 0, 0, 0), 1),

      Map.entry(List.of(0, 1, 1, 1, 1, 1), 5),
      Map.entry(List.of(0, 0, 1, 1, 1, 1), 4),
      Map.entry(List.of(0, 0, 0, 1, 1, 1), 3),
      Map.entry(List.of(0, 0, 0, 0, 1, 1), 2),
      Map.entry(List.of(0, 0, 0, 0, 0, 1), 1),

      Map.entry(List.of(0, 1, 1, 1, 1, 0), 4),
      Map.entry(List.of(0, 1, 1, 1, 0, 0), 3),
      Map.entry(List.of(0, 1, 1, 0, 0, 0), 2),
      Map.entry(List.of(0, 1, 0, 0, 0, 0), 1),

      Map.entry(List.of(0, 1, 0, 1, 1, 0), 3),
      Map.entry(List.of(1, 0, 1, 0, 0, 1), 2),
      Map.entry(List.of(1, 0, 1, 0, 0, 0), 2),

      Map.entry(List.of(0, 0, 0, 0, 0, 0), 0)
    );

    var result = allPatternsMap.getOrDefault(check, 0);

    return result > 0
            ? Map.of(PARTIAL, result)
            : Map.of(NOMATCH, 0);
  }
}