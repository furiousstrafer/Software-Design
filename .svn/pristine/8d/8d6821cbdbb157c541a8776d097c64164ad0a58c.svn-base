package colorgame;

import java.util.List;


public interface MasterMind {
    static List<Match> guess(List<Color> selectedColors, List<Color> userDefinedColors) {
        if (selectedColors.equals(userDefinedColors)) {
            return List.of(Match.EXACT, Match.EXACT, Match.EXACT, Match.EXACT, Match.EXACT, Match.EXACT);
        }
        return List.of(Match.NOMATCH, Match.NOMATCH, Match.NOMATCH, Match.NOMATCH, Match.NOMATCH, Match.NOMATCH);
    }
}